{
  "name": "taxi-conventionne-nice",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  // Garde les variables saisies dans le tableau de bord Cloudflare
  // (EASYTAXI_LIEN_RESERVATION...) a chaque deploiement depuis GitHub.
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Base de l'espace partenaires Google Ads (functions/partenaires.js).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partenaires",
      "database_id": "d4803017-41d8-45e7-997f-645fa6eb1734"
    }
  ]
}
